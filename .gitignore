# Dépendances et builds (chaque sous-projet a aussi son propre .gitignore)
node_modules/
dist/
coverage/
*.log

# Env
.env
.env.*

# Artefacts de test e2e
test-results/
playwright-report/

# Fichiers temporaires générés par Vite/Vitest lors de rechargements à chaud
# (config timestampée recréée à chaque redémarrage du serveur de dev)
*.timestamp-*.mjs
*.tsbuildinfo

# Fichiers de vérification ad hoc laissés par erreur
*.tmp.ts

# Q-008 (lot Qualité — Durcissement, 2026-08-22) : débris récurrents du
# pont device_bash (transferts de session Cowork) — la suppression de
# fichier n'étant pas permise sur ce point de montage, ces répertoires
# accumulent des archives/fichiers de transfert d'une session à l'autre
# (`_incoming/lot*.tar.gz`, `_to_delete/*`, zips de transfert au nom
# aléatoire type `ziXI1iMa`) ; ignorés plutôt que committés par erreur.
_incoming/
_to_delete/
_claude_tmp/
*.zip

# Feature 005 (US3) : état de progression de la collecte historique,
# généré à l'exécution de backend/src/scripts/backfill-historique.ts —
# opérationnel, jamais committé (plan.md, Complexity Tracking).
backfill-checkpoint.json

# OS / éditeurs
.DS_Store
Thumbs.db
